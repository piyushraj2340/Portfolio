# Public site origin used for metadata, sitemap, robots, and JSON-LD.
# Local: http://localhost:3000  |  Production: https://www.piyushraj.me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact API / email (server-only)
# Example local URI — use a MongoDB Atlas URI in production
MONGODB_URI=mongodb://localhost:27017/portfolio
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_TO=

# Optional — form limits (defaults shown)
# NEXT_PUBLIC_MIN_NAME_LENGTH=2
# NEXT_PUBLIC_MAX_NAME_LENGTH=100
# NEXT_PUBLIC_MIN_MESSAGE_LENGTH=10
# NEXT_PUBLIC_MAX_MESSAGE_LENGTH=2000

# Optional — contact rate limit (defaults: 3 requests / hour)
# RATE_LIMIT_WINDOW_MS=3600000
# MAX_REQUESTS_PER_WINDOW=3
